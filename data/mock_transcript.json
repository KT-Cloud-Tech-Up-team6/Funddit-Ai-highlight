{
  "transcript": [
    { "cue_id": "t_001", "start_ms": 0, "end_ms": 5000, "text": "안녕하세요, 로보락 라이브 방송에 오신 걸 환영합니다." },
    { "cue_id": "t_002", "start_ms": 6000, "end_ms": 11000, "text": "오늘은 신제품 F25 ACE 물걸레 청소기를 소개해 드릴게요." },
    { "cue_id": "t_003", "start_ms": 12000, "end_ms": 18000, "text": "방송 중에 댓글로 질문 남겨 주시면 순서대로 답변드리겠습니다." },
    { "cue_id": "t_004", "start_ms": 20000, "end_ms": 26000, "text": "시작하기 전에 오늘 혜택부터 잠깐 말씀드리고 갈게요." },
    { "cue_id": "t_005", "start_ms": 35000, "end_ms": 41000, "text": "사실 이 제품은 저희 팀의 불편함에서 시작됐습니다." },
    { "cue_id": "t_006", "start_ms": 42000, "end_ms": 49000, "text": "기존 물걸레 청소기를 쓰면서 손목이 너무 아팠어요." },
    { "cue_id": "t_007", "start_ms": 50000, "end_ms": 57000, "text": "걸레를 매번 손으로 빨아야 하는 것도 정말 번거로웠고요." },
    { "cue_id": "t_008", "start_ms": 58000, "end_ms": 65000, "text": "그래서 처음에는 세척만 자동으로 되게 해보자고 고민했습니다." },
    { "cue_id": "t_009", "start_ms": 66000, "end_ms": 74000, "text": "개발하면서 시제품을 열두 번 넘게 갈아엎었습니다." },
    { "cue_id": "t_010", "start_ms": 75000, "end_ms": 83000, "text": "물길 설계를 바꾸면서 세척력이 눈에 띄게 좋아졌어요." },
    { "cue_id": "t_011", "start_ms": 84000, "end_ms": 95000, "text": "그 과정에서 자동 출력 조절 아이디어도 같이 나왔습니다." },
    { "cue_id": "t_012", "start_ms": 96000, "end_ms": 104000, "text": "이 청소기는 그렇게 이 년의 개발 끝에 나온 제품입니다." },
    { "cue_id": "t_013", "start_ms": 110000, "end_ms": 117000, "text": "이제 스펙을 하나씩 살펴보겠습니다." },
    { "cue_id": "t_014", "start_ms": 118000, "end_ms": 126000, "text": "먼저 흡입력은 최대 만 파스칼까지 지원합니다." },
    { "cue_id": "t_015", "start_ms": 127000, "end_ms": 135000, "text": "일반 무선 청소기 대비 두 배 가까운 수치입니다." },
    { "cue_id": "t_016", "start_ms": 136000, "end_ms": 144000, "text": "배터리는 한 번 충전으로 최대 육십 분 사용 가능합니다." },
    { "cue_id": "t_017", "start_ms": 145000, "end_ms": 153000, "text": "본체 무게는 사 점 삼 킬로그램으로 가볍게 설계했습니다." },
    { "cue_id": "t_018", "start_ms": 154000, "end_ms": 163000, "text": "물걸레 자동 세척 기능이 기본 탑재되어 있습니다." },
    { "cue_id": "t_019", "start_ms": 164000, "end_ms": 173000, "text": "온수 세척이라 걸레에서 냄새가 나지 않아요." },
    { "cue_id": "t_020", "start_ms": 174000, "end_ms": 183000, "text": "바닥 재질을 감지하는 자동 출력 조절도 지원합니다." },
    { "cue_id": "t_021", "start_ms": 184000, "end_ms": 193000, "text": "먼지통은 원터치로 분리해서 물세척할 수 있습니다." },
    { "cue_id": "t_022", "start_ms": 194000, "end_ms": 202000, "text": "스펙은 여기까지 보시고, 이제 직접 보여드릴게요." },
    { "cue_id": "t_023", "start_ms": 210000, "end_ms": 216000, "text": "자, 그럼 실제로 한번 돌려보겠습니다." },
    { "cue_id": "t_024", "start_ms": 217000, "end_ms": 224000, "text": "여기 밀가루하고 커피 가루를 바닥에 뿌려놨어요." },
    { "cue_id": "t_025", "start_ms": 225000, "end_ms": 232000, "text": "전원 켜보겠습니다. 소리 들리시죠?" },
    { "cue_id": "t_026", "start_ms": 233000, "end_ms": 241000, "text": "지나가기만 해도 먼지가 그대로 빨려 들어갑니다." },
    { "cue_id": "t_027", "start_ms": 242000, "end_ms": 250000, "text": "물걸레가 같이 돌면서 얼룩까지 한 번에 닦이고 있어요." },
    { "cue_id": "t_028", "start_ms": 252000, "end_ms": 259000, "text": "이번에는 카펫 위로 한번 올려볼게요." },
    { "cue_id": "t_029", "start_ms": 260000, "end_ms": 267000, "text": "출력이 자동으로 올라가죠?" },
    { "cue_id": "t_030", "start_ms": 268000, "end_ms": 276000, "text": "지금 최대 만 파스칼까지 올라간 상태입니다." },
    { "cue_id": "t_031", "start_ms": 277000, "end_ms": 286000, "text": "카펫에서 내려오면 다시 출력이 알아서 내려갑니다." },
    { "cue_id": "t_032", "start_ms": 287000, "end_ms": 296000, "text": "이번에는 걸레 자동 세척을 보여드릴게요." },
    { "cue_id": "t_033", "start_ms": 297000, "end_ms": 306000, "text": "거치대에 꽂으면 온수 세척이 바로 시작됩니다." },
    { "cue_id": "t_034", "start_ms": 307000, "end_ms": 316000, "text": "일 분 정도면 걸레가 새것처럼 깨끗해집니다." },
    { "cue_id": "t_035", "start_ms": 322000, "end_ms": 330000, "text": "댓글 질문이 많이 올라왔네요. 하나씩 답변드릴게요." },
    { "cue_id": "t_036", "start_ms": 331000, "end_ms": 340000, "text": "층간소음 걱정하시는 분, 저소음 모드가 따로 있습니다." },
    { "cue_id": "t_037", "start_ms": 341000, "end_ms": 350000, "text": "필터는 육 개월에 한 번 교체하시면 됩니다." },
    { "cue_id": "t_038", "start_ms": 351000, "end_ms": 360000, "text": "AS는 전국 서비스센터에서 이 년 무상으로 받으실 수 있어요." },
    { "cue_id": "t_039", "start_ms": 361000, "end_ms": 370000, "text": "마루 바닥에도 물자국 없이 사용 가능합니다." },
    { "cue_id": "t_040", "start_ms": 371000, "end_ms": 381000, "text": "배터리 교체형인지 물어보셨는데, 자가 교체 가능합니다." },
    { "cue_id": "t_041", "start_ms": 382000, "end_ms": 392000, "text": "해외 직구 제품과 뭐가 다르냐는 질문도 있네요." },
    { "cue_id": "t_042", "start_ms": 393000, "end_ms": 403000, "text": "국내 정식 발매라 AS와 부품 수급이 완전히 다릅니다." },
    { "cue_id": "t_043", "start_ms": 404000, "end_ms": 413000, "text": "질문 감사합니다. 이제 오늘의 혜택 안내드릴게요." },
    { "cue_id": "t_044", "start_ms": 420000, "end_ms": 428000, "text": "오늘 펀딩 혜택 정리해 드리겠습니다." },
    { "cue_id": "t_045", "start_ms": 429000, "end_ms": 438000, "text": "정가는 사십구만 구천 원입니다." },
    { "cue_id": "t_046", "start_ms": 439000, "end_ms": 448000, "text": "그런데 오늘 얼리버드 펀딩가는 삼십구만 구천 원입니다." },
    { "cue_id": "t_047", "start_ms": 449000, "end_ms": 458000, "text": "십만 원 할인에 전용 거치대까지 기본 구성으로 드려요." },
    { "cue_id": "t_048", "start_ms": 459000, "end_ms": 468000, "text": "여기에 추가 걸레 세트 두 개를 사은품으로 드립니다." },
    { "cue_id": "t_049", "start_ms": 469000, "end_ms": 478000, "text": "얼리버드 물량은 삼백 대 한정입니다." },
    { "cue_id": "t_050", "start_ms": 479000, "end_ms": 488000, "text": "펀딩 마감까지 이제 삼 일 남았습니다." },
    { "cue_id": "t_051", "start_ms": 489000, "end_ms": 498000, "text": "지금 달성률이 벌써 팔백 퍼센트를 넘었어요." },
    { "cue_id": "t_052", "start_ms": 505000, "end_ms": 513000, "text": "오늘 준비한 내용은 여기까지입니다." },
    { "cue_id": "t_053", "start_ms": 514000, "end_ms": 523000, "text": "댓글 남겨주신 분들 모두 감사드립니다." },
    { "cue_id": "t_054", "start_ms": 524000, "end_ms": 533000, "text": "다음 방송에서 또 만나요. 감사합니다." }
  ]
}
