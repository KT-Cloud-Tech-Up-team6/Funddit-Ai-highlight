# Gemini (M1 구간 분할 / M2 포인트 자막)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Google Speech-to-Text v2 (CFG-2/3) — 서비스 계정 JSON 키 경로와 프로젝트 ID
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_STT_LOCATION=us

# 다른 회사 모델까지 비교할 때만 (현재 PoC는 Gemini 등급 비교로 한정)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
